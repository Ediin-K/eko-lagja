e=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#4A3A6B;swimlaneFillColor=#2B2B2B;strokeColor=#A0A0A0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="780" width="360" height="136" as="geometry" /></mxCell><mxCell id="c25" value="JPEG&lt;br&gt;PNG&lt;br&gt;PDF" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=wrap;fontColor=#FFFFFF;fontSize=11;fontFamily=Courier New;" vertex="1" parent="ftype"><mxGeometry y="40" width="360" height="61" as="geometry" /></mxCell><mxCell id="c26" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=#A0A0A0;" vertex="1" parent="ftype"><mxGeometry y="101" width="360" height="8" as="geometry" /></mxCell><mxCell id="c27" value="+ fromContentType(String): FileType {static}" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=wrap;fontColor=#FFFFFF;fontSize=11;fontFamily=Courier New;" vertex="1" parent="ftype"><mxGeometry y="109" width="360" height="27" as="geometry" /></mxCell><mxCell id="exc" value="«exception»&lt;br&gt;Domain exceptions" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#6B2E2E;swimlaneFillColor=#2B2B2B;strokeColor=#A0A0A0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1150" y="560" width="280" height="101" as="geometry" /></mxCell><mxCell id="c29" value="InvalidNoticeException (field)&lt;br&gt;NoticeNotActiveException (status)&lt;br&gt;FileNotAllowedException (reason)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=wrap;fontColor=#FFFFFF;fontSize=11;fontFamily=Courier New;" vertex="1" parent="exc"><mxGeometry y="40" width="280" height="61" as="geometry" /></mxCell><mxCell id="fprob" value="«enumeration»&lt;br&gt;FileProblem" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#4A3A6B;swimlaneFillColor=#2B2B2B;strokeColor=#A0A0A0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1150" y="700" width="280" height="152" as="geometry" /></mxCell><mxCell id="c31" value="NAME_MISSING&lt;br&gt;NAME_TOO_LONG&lt;br&gt;TYPE_NOT_ALLOWED&lt;br&gt;EMPTY&lt;br&gt;TOO_LARGE&lt;br&gt;CONTENT_MISMATCH" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=wrap;fontColor=#FFFFFF;fontSize=11;fontFamily=Courier New;" vertex="1" parent="fprob"><mxGeometry y="40" width="280" height="112" as="geometry" /></mxCell><mxCell id="n1" value="Attachment refers to its owner (a notice or a complaint) only by type and id, so the same class serves both modules. Max size 10 MB; file name at most 255 characters." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#3A3A3A;strokeColor=#A0A0A0;fontColor=#FFFFFF;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="860" width="440" height="60" as="geometry" /></mxCell><mxCell id="n2" value="expiresOn is the last valid day: publish and edit accept today or later.&lt;br&gt;statusOn(today): WITHDRAWN if withdrawnAt is set; else EXPIRED if today.isAfter(expiresOn); else ACTIVE. The status is never stored.&lt;br&gt;isVisibleIn(null, today): only whole-municipality notices.&lt;br&gt;Lengths: title at most 300, content at most 8000, category at most 50 characters." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#3A3A3A;strokeColor=#A0A0A0;fontColor=#FFFFFF;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="360" width="460" height="90" as="geometry" /></mxCell><mxCell id="e34" value="uses" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;fontSize=10;labelBackgroundColor=#333333;fontColor=#FFFFFF;strokeColor=#A0A0A0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="notice" target="status"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e35" value="type" style="endArrow=open;endFill=0;html=1;rounded=0;fontSize=10;labelBackgroundColor=#333333;fontColor=#FFFFFF;strokeColor=#A0A0A0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="notif" target="ntype"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e36" value="owner" style="startArrow=diamondThin;startFill=1;startSize=14;endArrow=open;endFill=0;html=1;rounded=0;fontSize=10;labelBackgroundColor=#333333;fontColor=#FFFFFF;strokeColor=#A0A0A0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="att" target="owner"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e37" value="type" style="endArrow=open;endFill=0;html=1;rounded=0;fontSize=10;labelBackgroundColor=#333333;fontColor=#FFFFFF;strokeColor=#A0A0A0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="owner" target="otype"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e38" value="fileType" style="endArrow=open;endFill=0;html=1;rounded=0;fontSize=10;labelBackgroundColor=#333333;fontColor=#FFFFFF;strokeColor=#A0A0A0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="att" target="ftype"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="240" y="850" /><mxPoint x="500" y="850" /></Array></mxGeometry></mxCell><mxCell id="e39" value="reason" style="endArrow=open;endFill=0;html=1;rounded=0;fontSize=10;labelBackgroundColor=#333333;fontColor=#FFFFFF;strokeColor=#A0A0A0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="exc" target="fprob"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>

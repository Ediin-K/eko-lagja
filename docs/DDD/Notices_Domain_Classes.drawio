<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net"><diagram id="notices-domain" name="Notices domain classes"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="980" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="legend" value="Domain classes of the Notices module (package domain/). Plain Java, no Spring or JPA.&lt;br&gt;Solid arrow: has a field of that type. Filled diamond: part of (composition). Dashed arrow: uses." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="40" as="geometry" /></mxCell><mxCell id="notice" value="Notice" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#1F4E79;swimlaneFillColor=#2B2B2B;strokeColor=#A0A0A0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="470" height="411" as="geometry" /></mxCell><mxCell id="c3" value="- id: Long&lt;br&gt;- title: String&lt;br&gt;- content: String&lt;br&gt;- category: String&lt;br&gt;- neighbourhoodIds: Set&amp;lt;Long&amp;gt;&lt;br&gt;- urgent: boolean&lt;br&gt;- publishedBy: Long&lt;br&gt;- publishedAt: Instant&lt;br&gt;- expiresOn: LocalDate&lt;br&gt;- withdrawnAt: Instant [0..1]" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=wrap;fontColor=#FFFFFF;fontSize=11;fontFamily=Courier New;" vertex="1" parent="notice"><mxGeometry y="26" width="470" height="180" as="geometry" /></mxCell><mxCell id="c4" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=#A0A0A0;" vertex="1" parent="notice"><mxGeometry y="206" width="470" height="8" as="geometry" /></mxCell><mxCell id="c5" value="+ publish(title, content, category, neighbourhoodIds,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;urgent, expiresOn, publishedBy, now): Notice {static}&lt;br&gt;+ edit(title, content, category, neighbourhoodIds,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;urgent, expiresOn, today): void&lt;br&gt;+ withdraw(now: Instant): void&lt;br&gt;+ statusOn(today: LocalDate): NoticeStatus&lt;br&gt;+ isVisibleIn(neighbourhoodId: Long, today: LocalDate): boolean&lt;br&gt;+ isForWholeMunicipality(): boolean&lt;br&gt;+ restore(id, title, content, category, neighbourhoodIds,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;urgent, publishedBy, publishedAt, expiresOn,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;withdrawnAt): Notice {static}" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=wrap;fontColor=#FFFFFF;fontSize=11;fontFamily=Courier New;" vertex="1" parent="notice"><mxGeometry y="214" width="470" height="197" as="geometry" /></mxCell><mxCell id="status" value="«enumeration»&lt;br&gt;NoticeStatus" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#4A3A6B;swimlaneFillColor=#2B2B2B;strokeColor=#A0A0A0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="120" width="170" height="101" as="geometry" /></mxCell><mxCell id="c7" value="ACTIVE&lt;br&gt;EXPIRED&lt;br&gt;WITHDRAWN" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwes